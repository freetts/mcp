{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "org.freetts/mcp",
  "title": "FreeTTS",
  "description": "Text to speech in 149 languages: MP3 links from any assistant. Free without an account.",
  "icons": [
    {
      "src": "https://mcp.freetts.org/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://mcp.freetts.org/icon-128.png",
      "mimeType": "image/png",
      "sizes": [
        "128x128"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/freetts/mcp",
    "source": "github"
  },
  "version": "1.0.8",
  "websiteUrl": "https://freetts.org/developers/mcp",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.freetts.org/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@freetts/mcp",
      "version": "1.0.8",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "FREETTS_API_KEY",
          "description": "Your FreeTTS API key from https://freetts.org/dashboard (API keys). A free key works; PRO adds HD voices, WAV, dialogue, Script mode and transcription.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
